<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="17dp"
    android:background="@drawable/widget_bg_dark">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:letterSpacing="0.08" android:text="FLYX CONTROL" android:textColor="#F7F8FA" android:textSize="11sp" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="● ONLINE" android:textColor="#62D98B" android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_accent_bar"
        android:layout_width="42dp"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:background="#FFCB05"
        android:text="" />


    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="12dp">
        <LinearLayout android:id="@+id/metric1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/metric1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#959DA8" android:textSize="10sp" />
            <TextView android:id="@+id/metric1_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#F7F8FA" android:textSize="20sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/metric2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/metric2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#959DA8" android:textSize="10sp" />
            <TextView android:id="@+id/metric2_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#F7F8FA" android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_secondary_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="#252A31" android:text="" />

    <LinearLayout android:id="@+id/widget_secondary_metrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
        <LinearLayout android:id="@+id/metric3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/metric3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#959DA8" android:textSize="9sp" />
            <TextView android:id="@+id/metric3_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#F7F8FA" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/metric4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
            <TextView android:id="@+id/metric4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="#959DA8" android:textSize="9sp" />
            <TextView android:id="@+id/metric4_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:textColor="#F7F8FA" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="sans-serif" android:textColor="#959DA8" android:textSize="9sp" />
</LinearLayout>
